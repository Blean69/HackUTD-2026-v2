# Copy to .env (never commit .env)

# --- LLM providers (all OpenAI-compatible) ---
LLM_PROVIDER_ORDER=nvidia,brev,tenvor_qwen

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # Super returns 404 for our key (2026-11-07); Ultra plans + calls tools
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # cheap/fast steps (classification, extraction)
NEMOTRON_VL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b    # page images -> fields (document extraction)

TENVOR_BASE_URL=https://api.tenvor.io/v1                    # placeholder — set real endpoint
TENVOR_API_KEY=
TENVOR_QWEN_MODEL=                                           # Qwen MoE fallback (tenvor serves Qwen only)

# --- Speech (NVIDIA ASR); browser Web Speech API is the fallback ---
NVIDIA_ASR_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa   # nemotron-asr-streaming (alt: parakeet-ctc-1.1b 1598d209-5e27-4d3c-8079-4751568b1081)
NVIDIA_ASR_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969   # magpie-tts-multilingual

# --- Worker tuning (all optional; defaults in services/worker/README.md) ---
NVIDIA_ASR_HTTP_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081   # Parakeet CTC, used by POST /asr (HTTP route)
NVIDIA_RPM=36                # stay under the ~40 req/min free tier
TENVOR_RPM=
LLM_CONCURRENCY=
LLM_TIMEOUT_MS=
LLM_RETRIES=
LLM_429_WAIT_MS=3000        # back off on NVIDIA 429s this long before failing over to Qwen
AGENT_THINKING=1             # Nemotron reasoning on for plans/summaries (shows as thought events)
AGENT_MAX_STEPS=
LLM_LOCAL_FALLBACK=          # true = fall back to the keyless local provider when every real provider fails
WORKER_CACHE_DIR=
WORKER_TOKEN_FILE=
WORKER_LABEL=

# --- Plaid Sandbox (dashboard.plaid.com → Developers → Keys; use the SANDBOX secret) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,liabilities,investments
PLAID_COUNTRY_CODES=US
PLAID_POLL_ATTEMPTS=10       # how long a fresh item waits for sandbox history (x PLAID_POLL_MS)
PLAID_POLL_MS=3000

# --- SpacetimeDB ---
SPACETIME_URI=ws://localhost:3000                  # prod: wss://maincloud.spacetimedb.com
SPACETIME_DB=keystone
WORKER_SECRET=keystone-dev-secret                  # must match WORKER_SECRET_SHA256 in spacetime/src; change for prod

# --- Agent worker ---
DEMO_MODE=cache_first        # cache_first | live
WORKER_PORT=8787
DATA_DIR=../../data/seed
FRED_API_KEY=                # optional; fixed rate table without it
DATA_GOV_API_KEY=DEMO_KEY    # College Scorecard

# --- Web (Next.js, port 3001 locally; SpacetimeDB owns :3000) ---
NEXT_PUBLIC_SPACETIME_URI=ws://localhost:3000
NEXT_PUBLIC_SPACETIME_DB=keystone
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
NEXT_PUBLIC_USE_MOCKS=0
PUBLIC_HOSTNAME=localhost    # prod: e.g. keystone.<your-domain>

# --- NVIDIA Brev: our own Nemotron on a Brev GPU (vLLM or NIM, OpenAI-compatible, no shared rate limit) ---
# Empty BREV_BASE_URL = off. Setup: docs/nvidia-stack.md "Brev". BREV_BASE_URL looks like https://<brev-share-url>/v1
# BREV_API_KEY is the --api-key given to vllm serve. BREV_NEMOTRON_MODEL is the served model name. BREV_FAST_MODEL defaults to it.
BREV_BASE_URL=
BREV_API_KEY=
BREV_NEMOTRON_MODEL=
BREV_FAST_MODEL=
BREV_RPM=0

# --- Voice agent: Talk button (browser WebRTC) + phone line ---
# Shared secret between the voice service and the worker's internal /phone routes (any long random string).
VOICE_SHARED_SECRET=
# Magpie TTS voice (all-NVIDIA). Alternatives: Magpie-Multilingual.EN-US.Aria.Calm
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Mia.Calm
# STUN/TURN for WebRTC, JSON list. Add Cloudflare TURN here only if venue Wi-Fi blocks UDP.
PIPECAT_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Where the browser reaches the voice service (prod: https://<host>/voice).
NEXT_PUBLIC_VOICE_URL=http://localhost:7860

# --- SignalWire phone number (optional; inbound calls only) ---
# Space URL looks like yourspace.signalwire.com. Project ID and API token: Dashboard > API.
# Signing key (Dashboard > API) lets the voice service verify that webhooks really come from SignalWire.
# Number in E.164 form, e.g. +12145550123. Point its incoming-call handler (cXML/LaML) at POST https://<host>/voice/twiml
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SIGNING_KEY=
SIGNALWIRE_PHONE_NUMBER=
# Keypad PINs that unlock a family on the phone line: pin:household_id, comma-separated.
PHONE_PINS=
# Random salt for hashing caller numbers (raw numbers are never stored).
PHONE_CALLER_SALT=
