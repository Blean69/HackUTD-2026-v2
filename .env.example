# Copy to .env (never commit .env)

# --- LLM providers (all OpenAI-compatible) ---
LLM_PROVIDER_ORDER=nvidia,tenvor_nemotron,tenvor_qwen

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5   # confirm current id in docs/nvidia-stack.md
NEMOTRON_FAST_MODEL=nvidia/nvidia-nemotron-nano-9b-v2       # cheap/fast steps (classification, extraction)

TENVOR_BASE_URL=https://api.tenvor.io/v1                    # placeholder — set real endpoint
TENVOR_API_KEY=
TENVOR_NEMOTRON_MODEL=                                       # Nemotron open weights served on tenvor (vLLM)
TENVOR_QWEN_MODEL=                                           # Qwen MoE fallback

# --- Speech (NVIDIA ASR); browser Web Speech API is the fallback ---
NVIDIA_ASR_FUNCTION_ID=
NVIDIA_ASR_SERVER=grpc.nvcf.nvidia.com:443

# --- SpacetimeDB ---
SPACETIME_URI=ws://localhost:3000                  # prod: wss://maincloud.spacetimedb.com
SPACETIME_DB=keystone
WORKER_SECRET=keystone-dev-secret                  # must match WORKER_SECRET_SHA256 in spacetime/src; change for prod

# --- Agent worker ---
DEMO_MODE=cache_first        # cache_first | live
WORKER_PORT=8787
DATA_DIR=../../data/seed
FRED_API_KEY=                # optional; fixed rate table without it
DATA_GOV_API_KEY=DEMO_KEY    # College Scorecard

# --- Web (Next.js, port 3001 locally; SpacetimeDB owns :3000) ---
NEXT_PUBLIC_SPACETIME_URI=ws://localhost:3000
NEXT_PUBLIC_SPACETIME_DB=keystone
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
NEXT_PUBLIC_USE_MOCKS=0
PUBLIC_HOSTNAME=localhost    # prod: e.g. keystone.<your-domain>
