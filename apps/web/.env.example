# Web app env (all NEXT_PUBLIC_* are inlined into the browser bundle at build time).
# SpacetimeDB (default port 3000, so `npm run dev` for the web app uses 3001)
NEXT_PUBLIC_SPACETIME_URI=ws://localhost:3000
NEXT_PUBLIC_SPACETIME_DB=keystone
# Agent worker: NVIDIA ASR at /asr, Plaid at /plaid/*. Any failure falls back gracefully.
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
# Voice service ("Talk to Brian" call button): Pipecat SmallWebRTC bot. POST /api/offer for signalling, GET /health for the
# availability check. Production: https://<host>/voice (Caddy strips the prefix). If unreachable, the button shows as disabled.
NEXT_PUBLIC_VOICE_URL=http://localhost:7860
# "Call Brian by phone": the SignalWire number shown in the app (tap-to-call link + the Talk sheet hint). E.164 or any format; unset = the
# team's line below; set it EMPTY to hide every phone surface. The household's 5-digit code is set in the app (Call Brian in the header).
NEXT_PUBLIC_PHONE_NUMBER=+18444681795
# Set to 1 to force the in-browser mock engine (no SpacetimeDB needed).
NEXT_PUBLIC_USE_MOCKS=

# Tip: open any page with ?as=<name> once to get a separate identity in the same browser (two "people" in two tabs).
