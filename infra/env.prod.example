# Keystone PRODUCTION environment. Copy to the repo root as .env.prod (git-ignored by the `.env.*` rule), fill in
# the secrets, then `infra/deploy.sh` uploads it to the box as /opt/keystone/.env.
#   cp infra/env.prod.example .env.prod
#
# This one file feeds three things:
#   1. docker compose interpolation (PUBLIC_HOSTNAME, ADMIN_IPS, build args)
#   2. the web image BUILD ARGS  (NEXT_PUBLIC_*; inlined into the browser bundle, so changing them needs a rebuild)
#   3. the worker container env  (env_file: everything else)
# Rules: no inline comments on value lines, no quotes, and NO "$" characters in values (compose would interpolate them).

# ---------------------------------------------------------------------------------------------------------------------
# Public host (pick ONE and keep these three lines consistent; the NEXT_PUBLIC_* ones are baked into the web image,
# so changing the host later means re-running infra/deploy.sh, which rebuilds web).
#   A) works right now, no DNS needed:   52-72-164-85.sslip.io   (resolves to the Elastic IP 52.72.164.85)
#   B) after you add an A record:        keystone.tenvor.io       -> 52.72.164.85
# ---------------------------------------------------------------------------------------------------------------------
PUBLIC_HOSTNAME=brianotron.us
# Space-separated hosts that redirect to PUBLIC_HOSTNAME (old QR codes, www). Changing PUBLIC_HOSTNAME also needs the
# SignalWire webhook moved to https://<PUBLIC_HOSTNAME>/voice/twiml: the phone signature is checked against that URL.
REDIRECT_HOSTNAMES=www.brianotron.us 52-72-164-85.sslip.io
NEXT_PUBLIC_WORKER_URL=https://brianotron.us/worker
NEXT_PUBLIC_USE_MOCKS=0

# Client IPs/CIDRs (space separated) allowed to publish/delete/inspect databases through Caddy. Everyone else can only
# subscribe, call reducers and run SQL. Add a laptop here when the team works from another network.
ADMIN_IPS=129.110.241.55/32

# ---------------------------------------------------------------------------------------------------------------------
# DATABASE: SpacetimeDB self-hosted on this box (default; the "spacetime" service in docker-compose.yml)
#   - the worker talks to the container directly (plain ws inside the compose network, never leaves the box)
#   - phones talk to wss://<PUBLIC_HOSTNAME>; Caddy forwards only the client routes to everyone (see Caddyfile)
#   - the database name is local to this box; SPACETIME_DB and NEXT_PUBLIC_SPACETIME_DB MUST be identical
# ---------------------------------------------------------------------------------------------------------------------
SPACETIME_URI=ws://spacetime:3000
SPACETIME_DB=keystone
NEXT_PUBLIC_SPACETIME_URI=wss://brianotron.us
NEXT_PUBLIC_SPACETIME_DB=keystone

# ---------------------------------------------------------------------------------------------------------------------
# ALTERNATIVE: SpacetimeDB Maincloud (deploy with: infra/deploy.sh --maincloud). Replace the four DATABASE lines above:
#SPACETIME_URI=wss://maincloud.spacetimedb.com
#SPACETIME_DB=keystone-hackutd26
#NEXT_PUBLIC_SPACETIME_URI=wss://maincloud.spacetimedb.com
#NEXT_PUBLIC_SPACETIME_DB=keystone-hackutd26
# The Maincloud database name is global: lowercase letters/digits/dashes, and it must be free.
# ---------------------------------------------------------------------------------------------------------------------

# ---------------------------------------------------------------------------------------------------------------------
# Worker secret: `openssl rand -hex 32`. deploy.sh stores only its SHA-256 in the database
# (admin_set_worker_secret_hash, publisher-only). No source edit needed.
WORKER_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# Agent worker (copy the real keys from your local .env)
# ---------------------------------------------------------------------------------------------------------------------
DEMO_MODE=cache_first
LLM_PROVIDER_ORDER=nvidia,brev,tenvor_qwen

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_VL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

TENVOR_BASE_URL=https://api.tenvor.io/v1
TENVOR_API_KEY=
TENVOR_QWEN_MODEL=

NVIDIA_ASR_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa
NVIDIA_ASR_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,liabilities,investments
PLAID_COUNTRY_CODES=US

FRED_API_KEY=
DATA_GOV_API_KEY=DEMO_KEY

# Set by docker-compose.yml, do not set here: WORKER_PORT (8787), DATA_DIR (/data/seed), WORKER_TOKEN_FILE, WORKER_CACHE_DIR.

# --- NVIDIA Brev: our own Nemotron on a Brev GPU (vLLM or NIM, OpenAI-compatible, no shared rate limit) ---
# Empty BREV_BASE_URL = off. Setup: docs/nvidia-stack.md "Brev". BREV_BASE_URL looks like https://<brev-share-url>/v1
# BREV_API_KEY is the --api-key given to vllm serve. BREV_NEMOTRON_MODEL is the served model name. BREV_FAST_MODEL defaults to it.
BREV_BASE_URL=
BREV_API_KEY=
BREV_NEMOTRON_MODEL=
BREV_FAST_MODEL=
BREV_RPM=0

# --- Voice agent: Talk button (browser WebRTC) + phone line ---
# Shared secret between the voice service and the worker's internal /phone routes (any long random string).
VOICE_SHARED_SECRET=
# Magpie TTS voice (all-NVIDIA). Alternatives: Magpie-Multilingual.EN-US.Jason (brisker), Leo.Neutral, Ray.Neutral
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Ray.Neutral
# STUN/TURN for WebRTC, JSON list. Add Cloudflare TURN here only if venue Wi-Fi blocks UDP.
PIPECAT_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# Where the browser reaches the voice service (prod: https://<host>/voice).
NEXT_PUBLIC_VOICE_URL=https://<host>/voice
# The "Call Brian" number the web app shows (tap-to-call link + Talk sheet hint); a BUILD ARG like the other NEXT_PUBLIC_* values.
# Unset = +18444681795 (the team's SignalWire line); set it empty to hide every phone surface. Households set their own 5-digit code in the app.
#NEXT_PUBLIC_PHONE_NUMBER=+18444681795

# --- SignalWire phone number (optional; inbound calls only) ---
# Space URL looks like yourspace.signalwire.com. Project ID and API token: Dashboard > API.
# Signing key (Dashboard > API) lets the voice service verify that webhooks really come from SignalWire.
# Number in E.164 form, e.g. +12145550123. Point its incoming-call handler (cXML/LaML) at POST https://<host>/voice/twiml
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SIGNING_KEY=
SIGNALWIRE_PHONE_NUMBER=
# optional: caller ID for Brian's callbacks (another number in the same space); empty = SIGNALWIRE_PHONE_NUMBER
SIGNALWIRE_CALLBACK_FROM=
# Keypad PINs that unlock a family on the phone line: pin:household_id, comma-separated.
PHONE_PINS=
# Number of keypad digits in each PIN (all PINs must be this long).
PHONE_PIN_LENGTH=5
# Random salt for hashing caller numbers (raw numbers are never stored).
PHONE_CALLER_SALT=
# Callback: about 15 s after a phone call that passed the PIN, Brian rings the same number back with a critical alert (needs the SIGNALWIRE_* values above).
# Defaults shown; docs: infra/DEPLOY.md "Phone callback". VOICE_CALLBACK_AMD = off | enable | detect_message_end (SignalWire answering-machine detection).
#VOICE_CALLBACK_ENABLED=1
#VOICE_CALLBACK_SECS=15
#VOICE_CALLBACK_RING_SECS=20
#VOICE_CALLBACK_AMD=off
#VOICE_CALLBACK_COOLDOWN_SECS=60
#VOICE_CALLBACK_MAX_PER_HOUR=20
# Input noise filter (RNNoise): auto = browser only | on = browser and phone | phone | off. Barge-in: words that interrupt Brian, and the echo guard.
#VOICE_NOISE_FILTER=auto
#VOICE_BARGE_IN_WORDS_WEBRTC=3
#VOICE_ECHO_OVERLAP=0.6

# --- Speaking voice engine (Nemotron still does ASR + reasoning + tools) ---
# magpie = NVIDIA Magpie (uses NVIDIA_TTS_VOICE) | elevenlabs | cartesia | openai_compatible. Missing key -> falls back to magpie.
TTS_PROVIDER=elevenlabs
# elevenlabs.io > Profile > API keys (enable Text to Speech + Voices read). Voice ID from the Voice Library / My Voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
# Eleven v4 Turbo: most realistic low-latency model (Sept 2026). Needs the text-to-dialogue WebSocket or HTTP streaming; the classic stream-input WebSocket rejects it with 400.
ELEVENLABS_MODEL=eleven_v4_turbo
