/*
 * Mirrors the tsconfig that `spacetime init --lang typescript` generates for the module.
 * The options in the "required" block are needed by SpacetimeDB; do not change them.
 * `allowImportingTsExtensions` is an addition so plain `node --test` can import .ts files.
 */
{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2021", "dom"],

    /* The following options are required by SpacetimeDB and should not be modified */
    "target": "ESNext",
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./src/**/*", "./vitest.config.ts"]
}
